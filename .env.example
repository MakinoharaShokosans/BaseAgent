# ==============================================================================
# BaseAgent 环境变量示例 (.env.example)
#
# 复制为 .env 后填写真实值。.env 绝不入版本库（见 .gitignore）。
#
# 放在这里的只有两类东西：
#   1. 密钥与凭据：API Key、令牌、第三方服务的访问凭据
#   2. 与机器或部署相关、不该写进共享配置的值：数据目录、配置文件路径
# 其余一切业务参数都在 config/config.toml。
#
# 任何配置项还可以用 BASEAGENT_<节>__<键> 覆盖 config.toml，例如：
#   BASEAGENT_SERVER__PORT=8010
#   BASEAGENT_RUNTIME__GUARDRAILS__MAX_STEPS=40
# 注意：监听地址仍受回环校验，覆盖成非回环地址会拒绝启动。
# ==============================================================================


# ------------------------------------------------------------------------------
# 模型密钥（config.toml 里的 api_key_env 引用这些名字）
# ------------------------------------------------------------------------------
# 推理档与快速档当前共用一个 DeepSeek 密钥。
DEEPSEEK_API_KEY=

# 若以后为不同档位或备用端点使用不同服务商，在此增加变量，
# 并在 config.toml 对应端点的 api_key_env 里引用，例如：
# BACKUP_API_KEY=


# ------------------------------------------------------------------------------
# 应用路径
# ------------------------------------------------------------------------------
# 数据目录。所有数据库、轨迹、产物、日志、令牌都在其下。
# 不设则使用 config.toml 的 [app] home。开发时建议指向仓库内的目录。
# BASEAGENT_HOME=./storage

# 配置文件路径。不设则依次查找 ./config/config.toml 和 $BASEAGENT_HOME/config.toml。
# BASEAGENT_CONFIG=./config/config.toml


# ------------------------------------------------------------------------------
# API 访问令牌
# ------------------------------------------------------------------------------
# 不设则首次启动自动生成并保存到 $BASEAGENT_HOME/api_token（权限 0600）。
# 仅在测试、CI 或容器里需要固定令牌时才设置；设了则优先于文件。
# BASEAGENT_API_TOKEN=


# ------------------------------------------------------------------------------
# MCP 服务器凭据（config.toml 里以 "env:VAR" 引用）
# ------------------------------------------------------------------------------
# 只在启用对应 MCP 服务器时才需要。
# GITHUB_TOKEN=


# ------------------------------------------------------------------------------
# 外部追踪导出（默认关闭，开启前请阅读 docs/08_observability/03_tracing.md 的隐私规则）
# ------------------------------------------------------------------------------
# OTLP_HEADERS=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=


# ------------------------------------------------------------------------------
# 网络代理（可选）
# ------------------------------------------------------------------------------
# 标准代理变量会被 HTTP 客户端识别。注意它们同时影响模型调用与 web_search 抓取。
# 对回环地址的访问应当绕过代理，务必同时设置 NO_PROXY。
# HTTPS_PROXY=
# HTTP_PROXY=
# NO_PROXY=127.0.0.1,localhost,::1


# ------------------------------------------------------------------------------
# 前端（Vite）
# ------------------------------------------------------------------------------
# 前端的 VITE_ 开头变量会被打包进浏览器代码，**绝不能放任何密钥**。
# 令牌由开发服务器的同源代理在服务端注入，不经过浏览器，见 docs/09_api/03_access_and_errors.md。
# 下面是仅供开发服务器代理读取的变量（无 VITE_ 前缀，不会进入打包产物）。
# BASEAGENT_PROXY_TARGET=http://127.0.0.1:11328
